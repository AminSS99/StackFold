{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stackfold",
  "version": "0.1.0",
  "identifier": "com.stackfold.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter=@stackfold/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter=@stackfold/web build:export",
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stackfold — Visual Control Center",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc:;",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../../../packages/scanner/dist/sidecar.cjs"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "dialog": null,
    "opener": null
  }
}
