  "dependencies": {
    "@stackfold/graph": "workspace:*",
    "@stackfold/platform": "workspace:*",
    "@stackfold/scanner": "workspace:*",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7"
  }
}
