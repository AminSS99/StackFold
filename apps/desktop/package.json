{
  "name": "@stackfold/desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "typecheck": "cargo check --manifest-path src-tauri/Cargo.toml",
