{
  "schemaVersion": 1,
  "domains": [
    {
      "id": "github-user",
      "displayName": "GitHub User ID",
      "kind": "provider_user",
      "provider": "GitHub",
      "typeNames": ["GitHubUserId"]
    },
    {
      "id": "database-user",
      "displayName": "Database User ID",
      "kind": "database_user",
      "typeNames": ["DatabaseUserId"]
    },
    {
      "id": "workspace",
      "displayName": "Workspace ID",
      "kind": "workspace",
      "typeNames": ["WorkspaceId"]
    }
  ],
  "allowedCrossings": [
    {
      "from": "github-user",
      "to": "database-user",
      "via": ["resolveDatabaseUserId"]
    }
  ]
}
